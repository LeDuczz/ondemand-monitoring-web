# Copy to .env and adjust as needed. See src/config/env.ts.

VITE_API_BASE_URL=http://localhost:8080
VITE_AWS_COGNITO_DOMAIN=
VITE_AWS_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_SIGN_IN=

# Mock API (src/mocks/README.md): true forces mock, false forces real
# backend, unset defaults to on in `npm run dev`.
VITE_USE_MOCK_API=true

# Hybrid mode: while VITE_USE_MOCK_API=true, these "METHOD /path" routes go to
# the real backend (`*` = one path segment, trailing `*` = any suffix).
VITE_REAL_API_ROUTES=GET /api/admin/users*,PATCH /api/admin/users/*/status,POST /api/admin/accounts,GET /api/users/me,PATCH /api/users/me
