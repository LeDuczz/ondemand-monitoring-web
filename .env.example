# Copy to .env and adjust as needed. See src/config/env.ts.

VITE_API_BASE_URL=http://localhost:8080
VITE_AWS_COGNITO_DOMAIN=
VITE_AWS_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_SIGN_IN=

# Mock API (src/mocks/README.md): true forces mock, false forces real
# backend, unset defaults to on in `npm run dev`.
VITE_USE_MOCK_API=true
